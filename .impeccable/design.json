      "css": ".ds-button-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:14px;font-weight:500;line-height:1.5;min-height:44px;padding:10px 16px;border-radius:var(--radius,6px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;white-space:nowrap;transition:background-color var(--fast,140ms),color var(--fast,140ms);background:var(--moss,#1e4d3f);color:var(--on-moss,#fffdf8);border:0;}.ds-button-primary:hover{background:var(--moss-hover,#14372d);}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:color 100ms,background-color 100ms;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared 44px action control; semantic variables follow the active theme.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Export backup</button>",
      "css": ".ds-button-secondary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:14px;font-weight:500;line-height:1.5;min-height:44px;padding:10px 16px;border-radius:var(--radius,6px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;white-space:nowrap;transition:background-color var(--fast,140ms),color var(--fast,140ms);background:var(--surface,#fffdf8);color:var(--ink,#1c1814);border:1px solid var(--rule,#dcd3c1);}.ds-button-secondary:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:color 100ms,background-color 100ms;}}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Shared 44px action control; semantic variables follow the active theme.",
      "html": "<button type=\"button\" class=\"ds-button-quiet\">Cancel</button>",
      "css": ".ds-button-quiet{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:14px;font-weight:500;line-height:1.5;min-height:44px;padding:10px 16px;border-radius:var(--radius,6px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;white-space:nowrap;transition:background-color var(--fast,140ms),color var(--fast,140ms);background:none;color:var(--muted,#625b50);border:0;}.ds-button-quiet:hover{background:var(--hover,#e9e3d7);color:var(--ink,#1c1814);}.ds-button-quiet:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-button-quiet:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:color 100ms,background-color 100ms;}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native field with quiet label and visible keyboard outline.",
      "html": "<label class=\"ds-field-label\">Title<input class=\"ds-field\" placeholder=\"What needs doing?\"></label>",
      "css": ".ds-field-label{display:flex;flex-direction:column;gap:8px;font:14px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;color:var(--muted,#625b50);}.ds-field{min-height:44px;padding:10px 12px;border:1px solid var(--rule,#dcd3c1);background:var(--surface,#fffdf8);color:var(--ink,#1c1814);border-radius:var(--radius,6px);font:16px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;caret-color:var(--moss,#1e4d3f);}.ds-field::placeholder{color:var(--muted,#625b50);opacity:1;}.ds-field:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-field:focus-visible{outline-offset:1px;}.ds-field[aria-invalid=\"true\"]{border-color:var(--danger,#a33c29);}"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "A current smart view; a snippet count illustrates the source layout, not user data.",
      "html": "<nav aria-label=\"Smart views\"><button class=\"ds-nav\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 6h12M8 12h12M8 18h12M3 6h.01M3 12h.01M3 18h.01\"/></svg><span>All Tasks</span><span class=\"ds-nav-count\">0</span></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:44px;width:100%;padding:11px 12px;border:0;border-radius:var(--radius,6px);background:none;color:var(--muted,#625b50);font:14px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;text-align:start;cursor:pointer;}.ds-nav svg{width:18px;height:18px;flex:none;}.ds-nav-count{margin-inline-start:auto;font-size:12px;font-weight:400;font-variant-numeric:tabular-nums;}.ds-nav:hover{background:var(--hover,#e9e3d7);}.ds-nav[aria-current=\"page\"]{background:var(--selected,#e0e5d8);color:var(--moss,#1e4d3f);font-weight:600;}.ds-nav:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}"
    },
    {
      "name": "Written Priority",
      "kind": "custom",
      "refersTo": "priority-high",
      "description": "Text plus dot; the source does not use a chip or badge container.",
      "html": "<span class=\"ds-priority\">High priority</span>",
      "css": ".ds-priority{display:inline-flex;gap:5px;align-items:center;color:var(--high,#98432d);font:12px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;}.ds-priority::before{content:\"\";width:5px;height:5px;display:inline-block;border-radius:50%;background:currentColor;}@media(forced-colors:active){.ds-priority::before{background:CanvasText;}}"
    },
    {
      "name": "Title-first Capture",
      "kind": "card",
      "refersTo": "capture",
      "description": "Flat capture container, not an elevated task card.",
      "html": "<section class=\"ds-capture\" aria-label=\"Quick task capture\"><label class=\"ds-capture-label\" for=\"ds-capture-input\">Task title</label><div class=\"ds-capture-line\"><input id=\"ds-capture-input\" placeholder=\"What needs doing?\"><button type=\"button\">Add</button></div><p class=\"ds-capture-context\">Project and date context</p></section>",
      "css": ".ds-capture{background:var(--surface,#fffdf8);border:1px solid var(--rule,#dcd3c1);border-radius:var(--radius,6px);}.ds-capture:focus-within{border-color:var(--moss,#1e4d3f);}.ds-capture-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);}.ds-capture-line{display:flex;align-items:center;padding:8px;gap:4px;}.ds-capture-line input{flex:1;width:0;min-width:0;min-height:44px;background:none;border:0;padding:12px 8px;color:var(--ink,#1c1814);font:16px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;}.ds-capture-line input::placeholder{color:var(--muted,#625b50);opacity:1;}.ds-capture-line button{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:14px;font-weight:500;line-height:1.5;min-height:44px;padding:10px 16px;border-radius:var(--radius,6px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;white-space:nowrap;transition:background-color var(--fast,140ms),color var(--fast,140ms);padding-inline:12px;border:0;background:var(--moss,#1e4d3f);color:var(--on-moss,#fffdf8);}.ds-capture-line button:hover{background:var(--moss-hover,#14372d);}.ds-capture-line button:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-capture-line input:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}.ds-capture-context{padding:0 16px 12px;margin:0;font:12px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;color:var(--muted,#625b50);}"
    },
    {
      "name": "Completion Control",
      "kind": "button",
      "refersTo": "task-row",
      "description": "Completed 20px mark within a full 44px native button.",
      "html": "<button class=\"ds-completion\" aria-label=\"Reopen task\" aria-pressed=\"true\"><span class=\"ds-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></button>",
      "css": ".ds-completion{display:flex;align-items:flex-start;justify-content:center;min-width:44px;min-height:44px;padding-top:3px;border:0;background:none;cursor:pointer;}.ds-mark{width:20px;height:20px;border:1px solid var(--moss,#1e4d3f);border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--moss,#1e4d3f);color:var(--on-moss,#fffdf8);transition:background-color var(--fast,140ms),border-color var(--fast,140ms);}.ds-mark svg{width:13px;height:13px;}.ds-completion:hover .ds-mark{border-color:var(--moss,#1e4d3f);background:var(--selected,#e0e5d8);}.ds-completion:focus-visible{outline:2px solid var(--focus,#41765f);outline-offset:4px;}@media(forced-colors:active){.ds-mark{outline:2px solid Highlight;}}"
    },
    {
      "name": "Protected Dialog Surface",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Static surface specimen of the native dialog; the application opens the actual dialog with showModal().",
      "html": "<section class=\"ds-dialog\" aria-label=\"Task editor surface\"><h2 class=\"ds-dialog-title\">A closer look.</h2><p>Protected work uses a native dialog in the application.</p></section>",
      "css": ".ds-dialog{border:0;border-radius:var(--radius-dialog,14px);background:var(--paper,#f6f1e7);color:var(--ink,#1c1814);box-shadow:var(--elevation,0 16px 64px #1c18142b);width:min(580px,calc(100% - 32px));max-height:calc(100dvh - 48px);padding:24px;overflow-y:auto;font:16px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;}.ds-dialog-title{font-family:var(--serif,\"Spectral\", Georgia, serif);font-size:28px;font-weight:400;line-height:1.15;letter-spacing:-.025em;margin:0 0 24px;}.ds-dialog p{margin:0;color:var(--muted,#625b50);}"
    }
  ],
  "narrative": {
    "northStar": "The Working Ledger",
    "overview": "Ledger extends the user-approved editorial identity: warm paper, quiet ink, moss actions, Spectral headings, thin rules, and native forms. The workspace should feel calm and useful while keeping capture, revision, and completion directly available.\n\nDensity comes from a legible ruled list and small supporting metadata, with space around destination headings and focused work. Light and dark themes share semantic roles and the same control grammar. Dark mode uses warm charcoal surfaces, cream text, and pale moss actions rather than treating the light palette as an inversion.",
    "keyCharacteristics": [
      "Warm paper and ink, with moss reserved for actions and state.",
      "Spectral headings paired with a practical system sans.",
      "Ruled task entries rather than dashboard cards.",
      "Visible keyboard focus, native dialogs, and touch-sized action controls.",
      "Quiet color transitions and brief, optional spatial motion."
    ],
    "rules": [
      {
        "name": "The The Semantic Pair Rule",
        "body": "Use the matching on-moss text with moss action fills; theme changes replace both together.",
        "section": "colors"
      },
      {
        "name": "The The Words Carry State Rule",
        "body": "Priority and overdue state retain readable words; color and small marks reinforce them.",
        "section": "colors"
      },
      {
        "name": "The The Editorial Hierarchy Rule",
        "body": "Use Spectral for destinations, focused task headings, and empty-state headings. Keep task text, navigation, forms, and operational labels in the system sans.",
        "section": "typography"
      },
      {
        "name": "The The Flat Ledger Rule",
        "body": "Keep the workspace and task rows flat. Reserve the shared elevation for floating dialogs and feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the same semantic roles and control shapes in light and dark themes.",
      "**Do** keep task rows ruled, long titles wrapping, and notes readable within 70ch.",
      "**Do** retain visible Edit, Focus, and notes controls without requiring hover.",
      "**Do** place small visible marks inside full action targets and keep row action controls at least 44px high.",
      "**Do** use native dialogs for protected editing, confirmation, navigation on phones, and focused work.",
      "**Do** remove dialog arrival movement when reduced motion is requested."
    ],
    "donts": [
      "**Don't** replace the approved warm-paper, ink, moss, and Spectral identity with a generic dashboard skin.",
      "**Don't** communicate priority, completion, or overdue state through color alone.",
      "**Don't** add elevation to ordinary task rows or turn the list into a wall of cards.",
      "**Don't** introduce decorative eyebrows to label content that already has a clear heading.",
      "**Don't** invent tasks, historical completion claims, or progress scores for visual fullness."
    ]
  }
}
